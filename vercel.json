{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/send.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/send",
      "destination": "/api/send.js"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}